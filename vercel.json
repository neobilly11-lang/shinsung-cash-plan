{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html",
      "permanent": false
    },
    {
      "source": "/app.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html",
      "permanent": false
    },
    {
      "source": "/scan.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html#scan",
      "permanent": false
    },
    {
      "source": "/inspection.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html#inspection",
      "permanent": false
    },
    {
      "source": "/completed.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html#completed",
      "permanent": false
    },
    {
      "source": "/po.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html#po",
      "permanent": false
    },
    {
      "source": "/shared.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html",
      "permanent": false
    },
    {
      "source": "/scan-inspect.html",
      "has": [{ "type": "header", "key": "host", "value": "shinsung-cash-plan-nk66.vercel.app" }],
      "destination": "/inspection-app.html#scan",
      "permanent": false
    },
    {
      "source": "/sales/",
      "destination": "/sales.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/scrap", "destination": "/scrap/index.html" },
    { "source": "/scrap/", "destination": "/scrap/index.html" },
    { "source": "/scrap-v2", "destination": "/scrap-v2/index.html" },
    { "source": "/scrap-v2/", "destination": "/scrap-v2/index.html" },
    { "source": "/sales", "destination": "/sales.html" }
  ],
  "headers": [
    {
      "source": "/inspection-app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/scrap-v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sales.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
